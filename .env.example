# Port de l'application (3002 sur VPS pour ne pas conflicte avec YogaOps sur 3000)
PORT=3002

# SMTP Gmail — pour l'envoi du formulaire de contact
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx   # App Password Google (16 caractères)
SMTP_TO=qadus.paris@gmail.com   # Adresse de réception des demandes

# URL du site (production)
NEXT_PUBLIC_SITE_URL=https://www.qadus.fr
